{
  "name": "@metaform/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p tests/tsconfig.json --noEmit --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "test:auth": "vitest run --config vitest.config.ts tests/auth.integration.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@metaform/shared-types": "*",
    "@prisma/adapter-pg": "latest",
    "@prisma/client": "latest",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "latest",
    "express": "latest",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/supertest": "^7.2.1",
    "prisma": "latest",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.10"
  }
}
