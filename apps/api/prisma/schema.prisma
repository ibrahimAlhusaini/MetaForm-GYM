generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  PREFER_NOT_TO_SAY
}

enum FitnessGoal {
  BUILD_MUSCLE
  LOSE_FAT
  MAINTAIN_WEIGHT
  IMPROVE_STRENGTH
  GENERAL_FITNESS
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  VERY_ACTIVE
  EXTREMELY_ACTIVE
}

enum BmiCategory {
  UNDERWEIGHT
  NORMAL
  OVERWEIGHT
  OBESITY
}

enum BmrFormula {
  MIFFLIN_ST_JEOR
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  LEGS
  CORE
  GLUTES
  LOWER_BACK
  FULL_BODY
}

enum MuscleSubgroup {
  UPPER_CHEST
  MIDDLE_CHEST
  LOWER_CHEST
  ALL_CHEST
  LATS
  UPPER_BACK
  MIDDLE_BACK
  TRAPS
  ALL_BACK
  FRONT_DELTS
  SIDE_DELTS
  REAR_DELTS
  ALL_SHOULDERS
  BICEPS_LONG_HEAD
  BICEPS_SHORT_HEAD
  BRACHIALIS
  ALL_BICEPS
  TRICEPS_LONG_HEAD
  TRICEPS_LATERAL_HEAD
  TRICEPS_MEDIAL_HEAD
  ALL_TRICEPS
  QUADRICEPS
  HAMSTRINGS
  CALVES
  ADDUCTORS
  ALL_LEGS
  UPPER_ABS
  LOWER_ABS
  OBLIQUES
  DEEP_CORE
  ALL_CORE
  GLUTE_MAXIMUS
  GLUTE_MEDIUS
  GLUTE_MINIMUS
  ALL_GLUTES
  ERECTOR_SPINAE
  ALL_LOWER_BACK
  ALL_FULL_BODY
}

enum EquipmentType {
  MACHINE
  DUMBBELL
  BARBELL
  CABLE
  BODYWEIGHT
  OTHER
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MovementType {
  COMPOUND
  ISOLATION
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AiCoachSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  passwordHash          String
  role                  UserRole               @default(USER)
  isActive              Boolean                @default(true)
  emailVerifiedAt       DateTime?              @db.Timestamptz(3)
  createdAt             DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @db.Timestamptz(3)
  profile               Profile?
  bodyMeasurements      BodyMeasurement[]
  customMachines        CustomMachine[]
  workoutSessions       WorkoutSession[]
  workoutPlans          WorkoutPlan[]
  nutritionCalculations NutritionCalculation[]
  aiCoachSessions       AiCoachSession[]
  refreshTokens         RefreshToken[]
}

model Profile {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @unique @db.Uuid
  fullName        String
  profileImageUrl String?
  gender          Gender?
  heightCm        Decimal?       @db.Decimal(5, 2)
  currentWeightKg Decimal?       @db.Decimal(6, 2)
  birthDate       DateTime?      @db.Date
  fitnessGoal     FitnessGoal?
  activityLevel   ActivityLevel?
  joinedAt        DateTime       @default(now()) @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  userAgent String?   @db.VarChar(512)
  ipAddress String?   @db.VarChar(45)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model BodyMeasurement {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  weightKg          Decimal  @db.Decimal(6, 2)
  bodyFatPercentage Decimal? @db.Decimal(5, 2)
  chestCm           Decimal? @db.Decimal(6, 2)
  waistCm           Decimal? @db.Decimal(6, 2)
  hipsCm            Decimal? @db.Decimal(6, 2)
  armCm             Decimal? @db.Decimal(6, 2)
  thighCm           Decimal? @db.Decimal(6, 2)
  notes             String?  @db.Text
  measuredAt        DateTime @default(now()) @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measuredAt(sort: Desc)])
}

model Exercise {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String                @unique
  description          String?               @db.Text
  primaryMuscle        MuscleGroup
  muscleSubgroup       MuscleSubgroup?
  secondaryMuscles     MuscleGroup[]         @default([])
  equipmentType        EquipmentType
  difficultyLevel      DifficultyLevel
  movementType         MovementType
  instructions         String[]              @default([])
  commonMistakes       String[]              @default([])
  recommendedSets      Int?
  recommendedReps      String?
  videoUrl             String?
  thumbnailUrl         String?
  isPublished          Boolean               @default(false)
  createdAt            DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @db.Timestamptz(3)
  exerciseLogs         ExerciseLog[]
  workoutPlanExercises WorkoutPlanExercise[]

  @@index([primaryMuscle, isPublished])
  @@index([muscleSubgroup, isPublished])
  @@index([isPublished, name])
  @@index([equipmentType, isPublished])
  @@index([secondaryMuscles], type: Gin)
}

model CustomMachine {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @db.Uuid
  name         String
  imageUrl     String?
  targetMuscle MuscleGroup
  description  String?       @db.Text
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseLogs ExerciseLog[]

  @@unique([userId, name])
  @@index([userId, targetMuscle])
}

model WorkoutSession {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  workoutPlanId String?       @db.Uuid
  startedAt     DateTime      @default(now()) @db.Timestamptz(3)
  completedAt   DateTime?     @db.Timestamptz(3)
  notes         String?       @db.Text
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutPlan   WorkoutPlan?  @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  exerciseLogs  ExerciseLog[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, completedAt(sort: Desc)])
  @@index([workoutPlanId])
}

model ExerciseLog {
  id               String         @id @default(uuid()) @db.Uuid
  workoutSessionId String         @db.Uuid
  exerciseId       String?        @db.Uuid
  customMachineId  String?        @db.Uuid
  notes            String?        @db.Text
  orderIndex       Int
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise         Exercise?      @relation(fields: [exerciseId], references: [id], onDelete: NoAction)
  customMachine    CustomMachine? @relation(fields: [customMachineId], references: [id], onDelete: NoAction)
  sets             ExerciseSet[]

  @@unique([workoutSessionId, orderIndex])
  @@index([exerciseId])
  @@index([customMachineId])
}

model ExerciseSet {
  id               String      @id @default(uuid()) @db.Uuid
  exerciseLogId    String      @db.Uuid
  setNumber        Int
  weightKg         Decimal?    @db.Decimal(7, 2)
  reps             Int?
  durationSeconds  Int?
  distanceMeters   Decimal?    @db.Decimal(10, 2)
  isWarmup         Boolean     @default(false)
  isPersonalRecord Boolean     @default(false)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  exerciseLog      ExerciseLog @relation(fields: [exerciseLogId], references: [id], onDelete: Cascade)

  @@unique([exerciseLogId, setNumber])
}

model WorkoutPlan {
  id              String           @id @default(uuid()) @db.Uuid
  userId          String?          @db.Uuid
  name            String
  description     String?          @db.Text
  difficultyLevel DifficultyLevel
  isTemplate      Boolean          @default(false)
  isPublic        Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
  user            User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  days            WorkoutPlanDay[]
  workoutSessions WorkoutSession[]

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([isPublic, isTemplate])
  @@index([isPublic, isTemplate, difficultyLevel])
}

model WorkoutPlanDay {
  id            String                @id @default(uuid()) @db.Uuid
  workoutPlanId String                @db.Uuid
  dayOfWeek     DayOfWeek
  name          String?
  notes         String?               @db.Text
  isRestDay     Boolean               @default(false)
  orderIndex    Int
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime              @updatedAt @db.Timestamptz(3)
  workoutPlan   WorkoutPlan           @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises     WorkoutPlanExercise[]

  @@unique([workoutPlanId, dayOfWeek])
  @@unique([workoutPlanId, orderIndex])
}

model WorkoutPlanExercise {
  id               String         @id @default(uuid()) @db.Uuid
  workoutPlanDayId String         @db.Uuid
  exerciseId       String         @db.Uuid
  sets             Int?
  reps             String?
  restSeconds      Int?
  notes            String?        @db.Text
  orderIndex       Int
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  workoutPlanDay   WorkoutPlanDay @relation(fields: [workoutPlanDayId], references: [id], onDelete: Cascade)
  exercise         Exercise       @relation(fields: [exerciseId], references: [id], onDelete: NoAction)

  @@unique([workoutPlanDayId, orderIndex])
  @@index([exerciseId])
}

model NutritionCalculation {
  id                   String         @id @default(uuid()) @db.Uuid
  userId               String         @db.Uuid
  bmi                  Decimal        @db.Decimal(5, 2)
  bmr                  Decimal        @db.Decimal(10, 2)
  tdee                 Decimal        @db.Decimal(10, 2)
  maintenanceCalories  Int
  bulkingCalories      Int
  cuttingCalories      Int
  proteinGrams         Decimal        @db.Decimal(8, 2)
  carbohydrateGrams    Decimal        @db.Decimal(8, 2)
  fatGrams             Decimal        @db.Decimal(8, 2)
  waterLiters          Decimal        @db.Decimal(5, 2)
  age                  Int?
  gender               Gender?
  heightCm             Decimal?       @db.Decimal(5, 2)
  weightKg             Decimal?       @db.Decimal(6, 2)
  activityLevel        ActivityLevel?
  fitnessGoal          FitnessGoal?
  recommendedCalories  Int?
  bmiCategory          BmiCategory?
  bmrFormula           BmrFormula?
  calculationVersion   String?        @db.VarChar(20)
  safetyFloorApplied   Boolean?
  macroFallbackApplied Boolean?
  calculatedAt         DateTime       @default(now()) @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @db.Timestamptz(3)
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, calculatedAt(sort: Desc)])
}

model AiCoachSession {
  id              String               @id @default(uuid()) @db.Uuid
  userId          String               @db.Uuid
  status          AiCoachSessionStatus @default(IN_PROGRESS)
  answers         Json
  recommendations Json?
  startedAt       DateTime             @default(now()) @db.Timestamptz(3)
  completedAt     DateTime?            @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @db.Timestamptz(3)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt(sort: Desc)])
  @@index([userId, status])
}
