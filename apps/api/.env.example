# REQUIRED: every API environment
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/metaform_gym?schema=public"
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS

# OPTIONAL: API runtime tuning (shown defaults)
PORT=3000
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
COOKIE_NAME=metaform_refresh_token

# OPTIONAL FEATURE: configure both values together to enable AI Coach
OPENAI_API_KEY=
AI_COACH_MODEL=

# REQUIRED IN PRODUCTION when Research Preview prediction routes are enabled.
# LOCAL DEVELOPMENT default points to the loopback-only shared FastAPI process.
BODY_WEIGHT_PREDICTION_SERVICE_URL=http://127.0.0.1:8001
BODY_WEIGHT_PREDICTION_TIMEOUT_MS=2000

# TEST ONLY: must identify an isolated database with a clear test marker.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/metaform_gym_test?schema=public"
