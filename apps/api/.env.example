DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/metaform_gym?schema=public"
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/metaform_gym_test?schema=public"
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=GENERATE_A_RANDOM_SECRET_WITH_AT_LEAST_32_CHARACTERS
