# ANALYTICS COMMANDS ONLY. The FastAPI prediction service does not read these.
# Use a PostgreSQL role with CONNECT and SELECT permissions only.
DATA_SCIENCE_DATABASE_URL=postgresql+psycopg://readonly_user:REPLACE_ME@localhost:5432/metaform_gym
# Recommended outside disposable local analysis. Never commit the real value.
DATA_SCIENCE_ANONYMIZATION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATA_SCIENCE_ARTIFACT_DIR=artifacts
DATA_SCIENCE_SYNTHETIC_SEED=20260807
