{
  "name": "metaform-gym",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace @metaform/web",
    "dev:api": "npm run dev --workspace @metaform/api",
    "dev:prediction": "data-science/.venv/Scripts/python.exe -m uvicorn metaform_ds.serving.app:app --app-dir data-science/src --host 127.0.0.1 --port 8001",
    "dev:all": "concurrently -n web,api,prediction -c cyan,green,magenta \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:prediction\"",
    "build": "npm run build --workspace @metaform/shared-types && npm run build --workspace @metaform/api && npm run build --workspace @metaform/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:api": "npm test --workspace @metaform/api",
    "test:db:create": "npm run test:db:create --workspace @metaform/api",
    "test:db:prepare": "npm run test:db:prepare --workspace @metaform/api",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "npm run prisma:generate --workspace @metaform/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @metaform/api",
    "prisma:studio": "npm run prisma:studio --workspace @metaform/api",
    "docker:build:api": "docker build --file apps/api/Dockerfile --tag metaform-gym-api:staging .",
    "docker:build:migration": "docker build --file apps/api/Dockerfile --target migration --tag metaform-gym-migration:staging .",
    "docker:build:prediction": "docker build --file data-science/Dockerfile --tag metaform-gym-prediction:staging data-science",
    "docker:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/docker-smoke.ps1",
    "infra:typecheck": "npm run typecheck --prefix infrastructure",
    "infra:test": "npm test --prefix infrastructure",
    "infra:synth": "npm run synth --prefix infrastructure"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "concurrently": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "prettier": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "typescript-eslint": "latest"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
